# Copy this file to .env.local for local development, and set the same
# keys in your Vercel / Cloudflare Pages project settings for deploys.
# All variables here are NEXT_PUBLIC_* because this is a fully static
# export with no server runtime -- nothing here should ever be a secret.

# --- Contact / partner / investor form -------------------------------
# Formspree form ID (from https://formspree.io -> your form -> Setup).
# The form degrades to a "mailto" fallback if this is unset, so the site
# still builds and works without it.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# --- Analytics (optional, pick at most one) ---------------------------
# Plausible: set your site domain exactly as configured in Plausible.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Google Analytics 4: set your Measurement ID (starts with "G-").
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Site URL -----------------------------------------------------------
# Canonical production URL, used for metadata, sitemap.xml and OG tags.
NEXT_PUBLIC_SITE_URL=https://gotechnologies.lk
